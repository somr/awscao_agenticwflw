+class FailOnceFulfilmentService(FulfilmentService):
+    """Test double: the first fulfil() call raises, later calls succeed."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.failures_remaining = 1
+
+    def fulfil(self, payment_id: str) -> None:
+        if self.failures_remaining:
+            self.failures_remaining -= 1
+            raise RuntimeError("fulfilment failed")
+        super().fulfil(payment_id)
+
+
+class AlwaysFailingFulfilmentService(FulfilmentService):
+    """Test double: every fulfil() call raises the same exception instance."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.error = RuntimeError("fulfilment failed")
+
+    def fulfil(self, payment_id: str) -> None:
+        raise self.error
+
+
+class RecordingRepository(PaymentRepository):
+    """Test double: a real repository that records release_claim and close calls."""
+
+    def __init__(self, db_path):
+        super().__init__(db_path)
+        self.release_calls: list[str] = []
+        self.closed = False
+
+    def release_claim(self, provider_event_id: str) -> bool:
+        self.release_calls.append(provider_event_id)
+        return super().release_claim(provider_event_id)
+
+    def close(self) -> None:
+        self.closed = True
+        super().close()
+
+
+class ReleaseFailingRepository(RecordingRepository):
+    """Test double: release_claim always raises."""
+
+    def release_claim(self, provider_event_id: str) -> bool:
+        self.release_calls.append(provider_event_id)
+        raise sqlite3.OperationalError("release failed")
+
+
+class ClaimFailingOnceRepository(RecordingRepository):
+    """Test double: the first record_if_new call raises OperationalError."""
+
+    def __init__(self, db_path):
+        super().__init__(db_path)
+        self.claim_failures_remaining = 1
+
+    def record_if_new(self, provider_event_id: str, payment_id: str) -> bool:
+        if self.claim_failures_remaining:
+            self.claim_failures_remaining -= 1
+            raise sqlite3.OperationalError("database is locked")
+        return super().record_if_new(provider_event_id, payment_id)
 
 

+import sqlite3
+import tempfile
+import unittest
+from pathlib import Path
+
+from payment_service.repository import PaymentRepository
+
+
+class PaymentRepositoryTest(unittest.TestCase):
+    def setUp(self):
+        self._tmpdir = tempfile.TemporaryDirectory()
+        self.db_path = Path(self._tmpdir.name) / "payments.db"
+        self.repository = PaymentRepository(self.db_path)
+        self._extra_repositories = []
+
+    def tearDown(self):
+        for repository in self._extra_repositories:
+            repository.close()
+        self.repository.close()
+        self._tmpdir.cleanup()
+
+    def _open_repository(self):
+        repository = PaymentRepository(self.db_path)
+        self._extra_repositories.append(repository)
+        return repository
+
+    def _row_count(self, provider_event_id):
+        conn = sqlite3.connect(str(self.db_path))
+        try:
+            (count,) = conn.execute(
+                "SELECT COUNT(*) FROM processed_callbacks WHERE provider_event_id = ?",
+                (provider_event_id,),
+            ).fetchone()
+        finally:
+            conn.close()
+        return count
+
+    def test_first_record_claims_event(self):
+        self.assertTrue(self.repository.record_if_new("evt-1", "pay-1"))
+        self.assertEqual(self._row_count("evt-1"), 1)
+
+    def test_duplicate_event_is_rejected_and_leaves_one_row(self):
+        self.assertTrue(self.repository.record_if_new("evt-1", "pay-1"))
+        self.assertFalse(self.repository.record_if_new("evt-1", "pay-1"))
+        self.assertEqual(self._row_count("evt-1"), 1)
+
+    def test_non_duplicate_integrity_error_is_raised_and_leaves_no_row(self):
+        with self.assertRaises(sqlite3.IntegrityError):
+            self.repository.record_if_new("evt-1", None)
+        self.assertEqual(self._row_count("evt-1"), 0)
+
+    def test_release_claim_removes_row_once(self):
+        self.repository.record_if_new("evt-1", "pay-1")
+        self.assertTrue(self.repository.release_claim("evt-1"))
+        self.assertEqual(self._row_count("evt-1"), 0)
+        self.assertFalse(self.repository.release_claim("evt-1"))
+

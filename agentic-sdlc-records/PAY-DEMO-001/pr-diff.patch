index 0000000..811c7f7
--- /dev/null
+++ b/app/payment_service/request_handler.py
@@ -0,0 +1,39 @@
+"""Request-scoped entry point for payment provider callbacks.
+
+Each call to CallbackRequestHandler.handle builds its own PaymentRepository
+(and therefore its own database connection), PaymentService and
+CallbackController, and closes the repository when the request finishes
+(CON-5). Only the FulfilmentService is shared across requests. The response
+is exactly the dict returned by CallbackController.handle (AC-2), and any
+exception propagates to the caller unchanged.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Callable
+
+from .callback_controller import CallbackController
+from .fulfilment_service import FulfilmentService
+from .payment_service import PaymentService
+from .repository import PaymentRepository
+
+
+class CallbackRequestHandler:
+    def __init__(
+        self,
+        db_path: str | Path,
+        fulfilment_service: FulfilmentService,
+        repository_factory: Callable[[str | Path], PaymentRepository] = PaymentRepository,
+    ):
+        self._db_path = db_path
+        self._fulfilment_service = fulfilment_service
+        self._repository_factory = repository_factory
+
+    def handle(self, body: dict[str, Any]) -> dict[str, Any]:
+        repository = self._repository_factory(self._db_path)
+        try:
+            service = PaymentService(repository, self._fulfilment_service)
+            controller = CallbackController(service)
+            return controller.handle(body)
+        finally:
+            repository.close()

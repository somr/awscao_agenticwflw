@@ -0,0 +1,109 @@
+import tempfile
+import threading
+import unittest
+from pathlib import Path
+
+from payment_service.fulfilment_service import FulfilmentService
+from payment_service.repository import PaymentRepository
+from payment_service.request_handler import CallbackRequestHandler
+
+WAIT_TIMEOUT = 10.0
+THREAD_COUNT = 8
+
+
+class BlockingFulfilmentService(FulfilmentService):
+    """Test double: fulfil() signals that it started, then blocks until released."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.started = threading.Event()
+        self.release = threading.Event()
+
+    def fulfil(self, payment_id: str) -> None:
+        self.started.set()
+        if not self.release.wait(WAIT_TIMEOUT):
+            raise RuntimeError("blocking fulfilment was never released")
+        super().fulfil(payment_id)
+
+
+class CallbackConcurrencyTest(unittest.TestCase):
+    def setUp(self):
+        self._tmpdir = tempfile.TemporaryDirectory()
+        self.db_path = Path(self._tmpdir.name) / "payments.db"
+        # Pre-create the table so concurrent requests do not race on schema creation.
+        PaymentRepository(self.db_path).close()
+
+    def tearDown(self):
+        self._tmpdir.cleanup()
+
+    def test_in_flight_duplicate_is_acknowledged_without_refulfilment(self):
+        fulfilment_service = BlockingFulfilmentService()
+        handler = CallbackRequestHandler(self.db_path, fulfilment_service)
+        body = {"provider_event_id": "evt-inflight", "payment_id": "pay-inflight"}
+        expected = {"status": "ok", "payment_id": "pay-inflight"}
+        original_responses: list[dict] = []
+        original_errors: list[BaseException] = []
+
+        def deliver_original():
+            try:
+                original_responses.append(handler.handle(body))
+            except BaseException as exc:
+                original_errors.append(exc)
+
+        original = threading.Thread(target=deliver_original, daemon=True)
+        original.start()
+        try:
+            self.assertTrue(
+                fulfilment_service.started.wait(WAIT_TIMEOUT),
+                "original delivery never reached fulfilment",
+            )
+            duplicate_response = handler.handle(body)
+            self.assertEqual(duplicate_response, expected)
+            self.assertEqual(fulfilment_service.ledger, [])
+        finally:
+            fulfilment_service.release.set()
+            original.join(WAIT_TIMEOUT)
+
+        self.assertFalse(original.is_alive(), "original delivery did not finish")
+        self.assertEqual(original_errors, [])
+        self.assertEqual(original_responses, [expected])
+        self.assertEqual(fulfilment_service.fulfilment_count("pay-inflight"), 1)
+
+    def test_concurrent_duplicates_fulfil_exactly_once(self):
+        fulfilment_service = FulfilmentService()
+        handler = CallbackRequestHandler(self.db_path, fulfilment_service)
+        body = {"provider_event_id": "evt-concurrent", "payment_id": "pay-concurrent"}
+        barrier = threading.Barrier(THREAD_COUNT)
+        responses: list[dict] = []
+        errors: list[BaseException] = []
+
+        def deliver():
+            try:
+                barrier.wait(WAIT_TIMEOUT)
+                responses.append(handler.handle(body))
+            except BaseException as exc:
+                errors.append(exc)
+
+        threads = [threading.Thread(target=deliver, daemon=True) for _ in range(THREAD_COUNT)]
+        with self.assertLogs("payment_service.payment_service", level="INFO") as captured:
+            for thread in threads:
+                thread.start()
+            for thread in threads:
+                thread.join(WAIT_TIMEOUT)
+
+        self.assertFalse(any(thread.is_alive() for thread in threads), "a delivery did not finish")
+        self.assertEqual(errors, [])
+        self.assertEqual(len(responses), THREAD_COUNT)
+        expected = {"status": "ok", "payment_id": "pay-concurrent"}
+        self.assertTrue(all(response == expected for response in responses))
+        self.assertEqual(fulfilment_service.fulfilment_count("pay-concurrent"), 1)
+
+        messages = [record.getMessage() for record in captured.records]
+        duplicates = [message for message in messages if "duplicate" in message.lower()]
+        processed = [message for message in messages if "callback processed" in message]
+        self.assertEqual(len(duplicates), THREAD_COUNT - 1)
+        self.assertEqual(len(processed), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()

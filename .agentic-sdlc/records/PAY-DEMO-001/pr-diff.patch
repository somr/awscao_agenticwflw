+    def release_for_retry(self, provider_event_id: str) -> None:
+        """Delete the claim row for provider_event_id so a later retry can
+        re-claim it via the same record_if_new() PRIMARY KEY constraint.
+        Idempotent: a no-op if the row is already gone."""
+        self._conn.execute(
+            "DELETE FROM processed_callbacks WHERE provider_event_id = ?",
+            (provider_event_id,),
+        )
+        self._conn.commit()
+
     def close(self) -> None:
         self._conn.close()

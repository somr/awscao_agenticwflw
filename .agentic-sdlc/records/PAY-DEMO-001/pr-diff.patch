+    def test_duplicate_after_completed_event_does_not_refulfil(self):
+        """FR-1: an event that already completed business processing must
+        not execute fulfilment again, even for a third/later delivery."""
+        self.controller.handle({"provider_event_id": "evt-4", "payment_id": "pay-4"})
+        self.controller.handle({"provider_event_id": "evt-4", "payment_id": "pay-4"})
+        self.controller.handle({"provider_event_id": "evt-4", "payment_id": "pay-4"})
+        self.assertEqual(self.fulfilment_service.fulfilment_count("pay-4"), 1)
+
+    def test_failed_fulfilment_releases_claim_for_successful_retry(self):
+        """FR-2/C-4: a fulfilment failure after claim releases the row so a
+        retry with the same provider_event_id can re-claim and succeed."""
+        failing_fulfilment_service = _FailOnceFulfilmentService()
+        payment_service = PaymentService(self.repository, failing_fulfilment_service)
+        controller = CallbackController(payment_service)
+
+        with self.assertRaises(RuntimeError):
+            controller.handle({"provider_event_id": "evt-5", "payment_id": "pay-5"})
+
+        response = controller.handle({"provider_event_id": "evt-5", "payment_id": "pay-5"})
+        self.assertEqual(response, {"status": "ok", "payment_id": "pay-5"})
+        self.assertEqual(failing_fulfilment_service.fulfilment_count("pay-5"), 1)
+
+        # D6: PaymentRepository exposes no row-count/existence read method,
+        # so row presence post-retry is proven indirectly: record_if_new()
+        # can only return False if a row is present, and the PRIMARY KEY on
+        # provider_event_id guarantees at most one such row.
+        self.assertFalse(self.repository.record_if_new("evt-5", "pay-5"))
+
+    def test_concurrent_duplicate_callbacks_fulfil_once(self):
+        """FR-3/FR-4/C-5: two genuinely concurrent callbacks for the same
+        provider_event_id, each using its own PaymentRepository connection
+        against the same on-disk store, must resolve to exactly one
+        fulfilment and identical successful responses."""
+        db_path = Path(self._tmpdir.name) / "payments.db"
+        shared_fulfilment_service = FulfilmentService()
+        barrier = threading.Barrier(2)
+        results: list[dict] = [None, None]
+        intervals: list[tuple[float, float]] = [None, None]
+
+        def worker(index: int) -> None:
+            repository = PaymentRepository(db_path)
+            payment_service = PaymentService(repository, shared_fulfilment_service)
+            controller = CallbackController(payment_service)
+            try:
+                barrier.wait()
+                start = time.monotonic()
+                results[index] = controller.handle(
+                    {"provider_event_id": "evt-concurrent", "payment_id": "pay-concurrent"}
+                )
+                intervals[index] = (start, time.monotonic())
+            finally:
+                repository.close()
+
+        threads = [threading.Thread(target=worker, args=(i,)) for i in range(2)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(
+            shared_fulfilment_service.fulfilment_count("pay-concurrent"),
+            1,
+        )
+        expected_response = {"status": "ok", "payment_id": "pay-concurrent"}
+        self.assertEqual(results[0], expected_response)
+        self.assertEqual(results[1], expected_response)
+
+        (start_a, end_a), (start_b, end_b) = intervals
+        self.assertTrue(
+            start_a <= end_b and start_b <= end_a,
+            "expected the two threads' call intervals to overlap in wall-clock time",
+        )
+
 

+        # business processing must not execute fulfilment again.
+        self.controller.handle({"provider_event_id": "evt-4", "payment_id": "pay-4"})
+        self.controller.handle({"provider_event_id": "evt-4", "payment_id": "pay-4"})
+        self.controller.handle({"provider_event_id": "evt-4", "payment_id": "pay-4"})
+        self.assertEqual(self.fulfilment_service.fulfilment_count("pay-4"), 1)
+
+    def test_fulfilment_failure_releases_claim_for_retry(self):
+        # FR-2/C-4: a failure after claim but before completion must release
+        # the claim so a retry with the same provider_event_id can re-claim
+        # and attempt fulfilment again.
+        fulfilment_service = _FailOnceFulfilmentService()
+        payment_service = PaymentService(self.repository, fulfilment_service)
+        controller = CallbackController(payment_service)
+
+        with self.assertRaises(RuntimeError):
+            controller.handle({"provider_event_id": "evt-5", "payment_id": "pay-5"})

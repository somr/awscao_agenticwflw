 class PaymentRepository:
+    """Must be constructed once per incoming callback request (a fresh
+    connection to the same store), never shared as a single long-lived
+    instance across concurrent requests. sqlite3 connections default to
+    check_same_thread=True, and sharing one instance across requests would
+    prevent concurrent inserts from genuinely racing at the persistence
+    layer, which is the mechanism the PRIMARY KEY idempotency guarantee
+    depends on.
+    """
+
     def __init__(self, db_path: str | Path):
-        self._conn = sqlite3.connect(str(db_path))
+        self._conn = sqlite3.connect(str(db_path), timeout=30)
+        self._conn.execute("PRAGMA journal_mode=WAL")
         self._conn.execute(
             """
             CREATE TABLE IF NOT EXISTS processed_callbacks (
@@ -39,5 +49,17 @@ class PaymentRepository:
         except sqlite3.IntegrityError:
             return False
 
+    def release_for_retry(self, provider_event_id: str) -> None:
+        """Delete the claim row for provider_event_id so a later retry can
+        re-claim it via record_if_new(). Idempotent: a no-op if the row is
+        already gone. This is the "release" half of the delete-then-reinsert
+        pattern; the "reinsert" half is simply a later, ordinary call to
+        record_if_new() for the same ID."""
+        self._conn.execute(
+            "DELETE FROM processed_callbacks WHERE provider_event_id = ?",
+            (provider_event_id,),
+        )
+        self._conn.commit()
+
     def close(self) -> None:
         self._conn.close()

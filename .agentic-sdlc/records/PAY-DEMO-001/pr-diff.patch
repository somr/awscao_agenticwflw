+class _FailOnceFulfilmentService(FulfilmentService):
+    """Test-only fulfilment stub: raises on the first fulfil() call for a
+    given payment_id, then behaves normally on every subsequent call. Used
+    to simulate "claimed, then failed, then retried" for FR-2 coverage."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self._already_raised_for: set[str] = set()
+
+    def fulfil(self, payment_id: str) -> None:
+        if payment_id not in self._already_raised_for:
+            self._already_raised_for.add(payment_id)
+            raise RuntimeError("simulated fulfilment failure")
+        super().fulfil(payment_id)
+
+

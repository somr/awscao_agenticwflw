 """Orchestrates persistence + fulfilment for a payment provider callback.
 
-Known gap (tracked by PAY-DEMO-001): a duplicate callback for the same
-provider_event_id currently triggers fulfilment again instead of being
-recognized as already processed.
+Idempotency (PAY-DEMO-001): record_if_new()'s return value gates fulfilment.
+A duplicate (already-completed or currently in-flight) is rejected without
+side effects. If fulfilment fails after the claim is taken, the claim is
+released so a later retry with the same provider_event_id can re-claim it.
 """
 from __future__ import annotations
 
@@ -21,7 +22,23 @@ class PaymentService:

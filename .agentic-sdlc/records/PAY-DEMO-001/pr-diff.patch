+    def test_concurrent_duplicate_callbacks_do_not_double_fulfil(self):
+        fulfilment_service = FulfilmentService()
+        barrier = threading.Barrier(2)
+        results: dict[str, dict] = {}
+        intervals: dict[str, tuple[float, float]] = {}
+
+        def worker(name: str) -> None:
+            # Each thread constructs its own PaymentRepository against the
+            # shared on-disk file, inside its own thread function (C-5):
+            # sqlite3 connections default to check_same_thread=True.
+            repository = PaymentRepository(self.db_path)
+            try:

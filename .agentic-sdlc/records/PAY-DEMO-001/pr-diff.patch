-        self._repository.record_if_new(event.provider_event_id, event.payment_id)
-        self._fulfilment_service.fulfil(event.payment_id)
+        claimed = self._repository.record_if_new(event.provider_event_id, event.payment_id)
+        if not claimed:
+            logger.info(
+                "duplicate callback ignored for provider_event_id=%s",
+                event.provider_event_id,
+            )
+            return ProcessingResult(payment_id=event.payment_id, fulfilled=False)
+
+        try:
+            self._fulfilment_service.fulfil(event.payment_id)
+        except Exception:
+            self._repository.release_for_retry(event.provider_event_id)
+            logger.info(
+                "fulfilment failed for provider_event_id=%s; claim released for retry",
+                event.provider_event_id,
+            )
+            raise
+
         logger.info("callback processed for provider_event_id=%s", event.provider_event_id)
         return ProcessingResult(payment_id=event.payment_id, fulfilled=True)

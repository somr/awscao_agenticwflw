+class _FailOnceFulfilmentService(FulfilmentService):
+    """Test-only fulfilment stub that raises on its first invocation for a
+    given payment_id and succeeds on every subsequent call, simulating a
+    claimed-then-failed-then-retried fulfilment (FR-2)."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self._failed_once_for: set[str] = set()
+
+    def fulfil(self, payment_id: str) -> None:
+        if payment_id not in self._failed_once_for:
+            self._failed_once_for.add(payment_id)
+            raise RuntimeError("simulated fulfilment failure")
+        super().fulfil(payment_id)
+
+

+                    {"provider_event_id": "evt-fr3", "payment_id": "pay-fr3"}
+                )
+                end = time.monotonic()
+                results[name] = response
+                intervals[name] = (start, end)
+            finally:
+                repository.close()
+
+        threads = [threading.Thread(target=worker, args=(name,)) for name in ("a", "b")]
+        for t in threads:
+            t.start()
+        for t in threads:

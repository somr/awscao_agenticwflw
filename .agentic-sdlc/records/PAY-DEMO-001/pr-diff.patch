 class PaymentRepository:
+    """A fresh instance (and thus a fresh sqlite3 connection) must be
+    constructed per incoming callback request; never share a single
+    long-lived instance across concurrent requests, so that concurrent
+    inserts genuinely race at the persistence layer rather than being
+    serialized in-process. sqlite3 connections also default to
+    check_same_thread=True, so a connection must be constructed inside the
+    thread that will use it.
+    """
+
+    _BUSY_TIMEOUT_SECONDS = 30
+
     def __init__(self, db_path: str | Path):
-        self._conn = sqlite3.connect(str(db_path))
+        # An explicit busy timeout plus WAL mode lets two genuinely
+        # concurrent INSERTs against the same on-disk file resolve cleanly
+        # via the PRIMARY KEY constraint (one succeeds, one raises
+        # IntegrityError) instead of intermittently surfacing
+        # sqlite3.OperationalError: database is locked.
+        self._conn = sqlite3.connect(str(db_path), timeout=self._BUSY_TIMEOUT_SECONDS)
+        self._conn.execute("PRAGMA journal_mode=WAL")
         self._conn.execute(
             """
             CREATE TABLE IF NOT EXISTS processed_callbacks (
@@ -39,5 +56,18 @@ class PaymentRepository:
         except sqlite3.IntegrityError:
             return False
 
+    def release_for_retry(self, provider_event_id: str) -> None:
+        """Delete the claim row for provider_event_id, freeing it for a
+        later record_if_new() call to re-claim. Idempotent: a no-op if the
+        row is already gone. This is the release half of the
+        delete-then-reinsert pattern; the reinsert half is simply a later,
+        ordinary call to record_if_new() for the same ID.
+        """
+        self._conn.execute(
+            "DELETE FROM processed_callbacks WHERE provider_event_id = ?",
+            (provider_event_id,),
+        )
+        self._conn.commit()
+
     def close(self) -> None:
         self._conn.close()

+    def test_duplicate_after_completed_event_does_not_refulfil(self):
+        self.controller.handle({"provider_event_id": "evt-4", "payment_id": "pay-4"})
+        self.controller.handle({"provider_event_id": "evt-4", "payment_id": "pay-4"})
+        self.controller.handle({"provider_event_id": "evt-4", "payment_id": "pay-4"})
+        self.assertEqual(self.fulfilment_service.fulfilment_count("pay-4"), 1)
+
+    def test_failure_then_retry_refulfils_and_reclaims_id(self):
+        class FailOnceFulfilmentService(FulfilmentService):
+            def __init__(self):
+                super().__init__()
+                self._raised = False
+
+            def fulfil(self, payment_id: str) -> None:
+                if not self._raised:
+                    self._raised = True
+                    raise RuntimeError("simulated fulfilment failure")
+                super().fulfil(payment_id)
+
+        fulfilment_service = FailOnceFulfilmentService()
+        payment_service = PaymentService(self.repository, fulfilment_service)
+        controller = CallbackController(payment_service)
+
+        with self.assertLogs("payment_service.payment_service", level="WARNING") as captured:
+            with self.assertRaises(RuntimeError):
+                controller.handle({"provider_event_id": "evt-5", "payment_id": "pay-5"})
+        joined = "\n".join(captured.output)
+        self.assertIn("fulfilment failed for provider_event_id=evt-5", joined)
+        self.assertIn("claim released for retry", joined)
+
+        response = controller.handle({"provider_event_id": "evt-5", "payment_id": "pay-5"})
+        self.assertEqual(response, {"status": "ok", "payment_id": "pay-5"})
+        self.assertEqual(fulfilment_service.fulfilment_count("pay-5"), 1)
+
+        # D6: PaymentRepository exposes no row-count/existence read method, so
+        # row presence after the retry is proven indirectly: record_if_new()
+        # can only return False if a row is present, and the schema's
+        # PRIMARY KEY on provider_event_id guarantees at most one such row.
+        self.assertFalse(self.repository.record_if_new("evt-5", "pay-5"))
+
+    def test_genuine_concurrent_duplicate_does_not_refulfil(self):
+        db_path = Path(self._tmpdir.name) / "concurrent.db"
+        # Ensure the schema exists before both threads race against the file.
+        PaymentRepository(db_path).close()
+
+        fulfilment_service = FulfilmentService()
+        barrier = threading.Barrier(2)
+        results = {}
+        intervals = {}
+
+        def worker(name: str) -> None:
+            repository = PaymentRepository(db_path)
+            payment_service = PaymentService(repository, fulfilment_service)
+            controller = CallbackController(payment_service)
+            try:
+                barrier.wait()
+                start = time.monotonic()
+                results[name] = controller.handle(
+                    {"provider_event_id": "evt-concurrent", "payment_id": "pay-concurrent"}
+                )
+                intervals[name] = (start, time.monotonic())
+            finally:
+                repository.close()
+
+        thread_a = threading.Thread(target=worker, args=("a",))
+        thread_b = threading.Thread(target=worker, args=("b",))
+        thread_a.start()
+        thread_b.start()
+        thread_a.join()
+        thread_b.join()
+
+        self.assertEqual(fulfilment_service.fulfilment_count("pay-concurrent"), 1)
+        expected = {"status": "ok", "payment_id": "pay-concurrent"}
+        self.assertEqual(results["a"], expected)
+        self.assertEqual(results["b"], expected)
+
+        (a_start, a_end) = intervals["a"]
+        (b_start, b_end) = intervals["b"]
+        self.assertTrue(
+            a_start < b_end and b_start < a_end,
+            "expected the two threads' call intervals to overlap in wall-clock time",
+        )
+
 
 if __name__ == "__main__":
     unittest.main()

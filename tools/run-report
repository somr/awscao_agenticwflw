#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from collections import defaultdict
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterable
from urllib.error import HTTPError, URLError
from urllib.parse import quote
from urllib.request import Request, urlopen

DEFAULT_API_BASE = os.environ.get("CAO_API_BASE_URL", "http://127.0.0.1:9889").rstrip("/")
TERMINAL_STEP_EVENTS = {"step.completed", "step.failed", "step.skipped"}

class ReportError(RuntimeError):
    pass

def iso(value: str | None) -> datetime | None:
    if not value:
        return None
    value = value.strip()
    if value.endswith("Z"):
        value = value[:-1] + "+00:00"
    dt = datetime.fromisoformat(value)
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)

def seconds(start: str | None, end: str | None, now: datetime) -> float | None:
    a = iso(start)
    if not a:
        return None
    b = iso(end) if end else now
    return max(0.0, (b - a).total_seconds())

def fmt_duration(value: float | None) -> str:
    if value is None:
        return "N/A"
    s = int(round(value))
    h, rem = divmod(s, 3600)
    m, sec = divmod(rem, 60)
    if h:
        return f"{h}h {m:02d}m {sec:02d}s"
    if m:
        return f"{m}m {sec:02d}s"
    return f"{sec}s"

def fmt_money(value: float | None, currency: str) -> str:
    if value is None:
        return "N/A"
    sym = {"USD": "$", "EUR": "€", "GBP": "£"}.get(currency.upper())
    return f"{sym}{value:,.4f}" if sym else f"{value:,.4f} {currency.upper()}"

def http_json(url: str, token: str | None, timeout: float) -> Any:
    headers = {"Accept": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = Request(url, headers=headers)
    try:
        with urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode("utf-8"))
    except HTTPError as e:
        body = e.read().decode("utf-8", "replace")
        raise ReportError(f"HTTP {e.code} for {url}: {body[:500]}") from e
    except URLError as e:
        raise ReportError(f"Cannot reach CAO at {url}: {e}") from e

def load_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as e:
        raise ReportError(f"File not found: {path}") from e
    except json.JSONDecodeError as e:
        raise ReportError(f"Invalid JSON in {path}: {e}") from e

def repo_root(start: Path) -> Path:
    here = start.resolve()
    for p in (here, *here.parents):
        if (p / ".git").exists():
            return p
    return here

def discover_usage(repo: Path, run_id: str) -> Path | None:
    root = repo / ".agentic-sdlc" / "runtime"
    if not root.exists():
        return None
    matches = list(root.glob(f"**/{run_id}/usage.json"))
    return matches[0] if len(matches) == 1 else None

@dataclass
class Stage:
    step_id: str
    state: str
    attempts: int
    started_at: str | None
    finished_at: str | None
    duration: float | None
    provider: str | None
    profile: str | None

def build_stages(run: dict[str, Any], events: list[dict[str, Any]], now: datetime) -> list[Stage]:
    projections = {s["id"]: s for s in run.get("steps", []) if isinstance(s, dict) and s.get("id")}
    starts, finishes, providers, profiles = {}, {}, {}, {}
    ordered, seen = [], set()

    for ev in sorted(events, key=lambda e: e.get("seq", 0)):
        sid = ev.get("step_id")
        if not sid:
            continue
        if sid not in seen:
            seen.add(sid)
            ordered.append(sid)
        et, ts = ev.get("event_type"), ev.get("ts")
        if et == "step.started" and ts and sid not in starts:
            starts[sid] = ts
        if et in TERMINAL_STEP_EVENTS and ts:
            finishes[sid] = ts
        if ev.get("provider") and sid not in providers:
            providers[sid] = ev["provider"]
        if ev.get("agent_profile") and sid not in profiles:
            profiles[sid] = ev["agent_profile"]

    for sid in projections:
        if sid not in seen:
            ordered.append(sid)

    result = []
    for sid in ordered:
        p = projections.get(sid, {})
        state = str(p.get("state") or "unknown")
        attempts = int(p.get("attempts") or 0)
        result.append(Stage(
            sid, state, attempts,
            starts.get(sid), finishes.get(sid),
            seconds(starts.get(sid), finishes.get(sid), now) if starts.get(sid) else None,
            providers.get(sid), profiles.get(sid)
        ))
    return result

def union_duration(intervals: Iterable[tuple[datetime, datetime]]) -> float:
    spans = sorted((a, b) for a, b in intervals if b >= a)
    if not spans:
        return 0.0
    total = 0.0
    a0, b0 = spans[0]
    for a, b in spans[1:]:
        if a <= b0:
            b0 = max(b0, b)
        else:
            total += (b0 - a0).total_seconds()
            a0, b0 = a, b
    return total + (b0 - a0).total_seconds()

def token_map(raw: Any) -> dict[str, int]:
    if not isinstance(raw, dict):
        return {}
    out = {}
    for k, v in raw.items():
        try:
            n = int(v)
        except (TypeError, ValueError):
            continue
        if n >= 0:
            out[str(k)] = n
    return out

def compute_cost(usage: dict[str, Any] | None, models: dict[str, Any],
                 usage_currency: str, pricing_currency: str):
    warnings = []
    if not usage:
        return None, None, {}, warnings

    tokens = token_map(usage.get("tokens"))
    if usage.get("reported_cost") is not None:
        try:
            value = float(usage["reported_cost"])
        except (TypeError, ValueError):
            warnings.append("reported_cost is not numeric")
        else:
            cur = str(usage.get("currency", usage_currency)).upper()
            if cur != pricing_currency:
                warnings.append(f"reported cost currency {cur} differs from {pricing_currency}; no FX conversion")
                return None, None, tokens, warnings
            return value, "reported", tokens, warnings

    model = usage.get("model")
    if not model:
        warnings.append("no model and no reported_cost")
        return None, None, tokens, warnings
    price = models.get(str(model))
    if not isinstance(price, dict):
        warnings.append(f"no pricing configured for model '{model}'")
        return None, None, tokens, warnings
    rates = price.get("rates_per_million")
    if not isinstance(rates, dict):
        warnings.append(f"model '{model}' has no rates_per_million")
        return None, None, tokens, warnings
    if not tokens:
        warnings.append(f"model '{model}' has no token counts")
        return None, None, tokens, warnings

    cost = 0.0
    missing = []
    for category, count in tokens.items():
        if not count:
            continue
        rate = rates.get(category)
        if rate is None:
            missing.append(category)
            continue
        try:
            cost += count / 1_000_000 * float(rate)
        except (TypeError, ValueError):
            missing.append(category)
    if missing:
        warnings.append("missing rate(s): " + ", ".join(sorted(missing)))
        return None, None, tokens, warnings
    return cost, "estimated", tokens, warnings

def table(rows: list[list[str]], headers: list[str]) -> str:
    widths = [len(h) for h in headers]
    for row in rows:
        for i, v in enumerate(row):
            widths[i] = max(widths[i], len(v))
    lines = [
        "  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)),
        "  ".join("-" * w for w in widths),
    ]
    lines += ["  ".join(v.ljust(widths[i]) for i, v in enumerate(row)) for row in rows]
    return "\n".join(lines)

def main() -> int:
    ap = argparse.ArgumentParser(description="CAO workflow duration, token and cost report")
    ap.add_argument("run_id")
    ap.add_argument("--api-base", default=DEFAULT_API_BASE)
    ap.add_argument("--token", default=os.environ.get("CAO_API_TOKEN"))
    ap.add_argument("--timeout", type=float, default=15.0)
    ap.add_argument("--repo", type=Path, default=Path.cwd())
    ap.add_argument("--usage-file", type=Path)
    ap.add_argument("--pricing-file", type=Path)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--output", type=Path)
    ap.add_argument("--run-json", type=Path, help=argparse.SUPPRESS)
    ap.add_argument("--events-json", type=Path, help=argparse.SUPPRESS)
    args = ap.parse_args()

    try:
        rid = quote(args.run_id, safe="")
        run = load_json(args.run_json) if args.run_json else http_json(
            f"{args.api_base}/workflows/runs/{rid}", args.token, args.timeout)
        event_body = load_json(args.events_json) if args.events_json else http_json(
            f"{args.api_base}/workflows/runs/{rid}/events?after_seq=0", args.token, args.timeout)
        events = event_body.get("events", [])
        gaps = event_body.get("gaps", [])
        now = datetime.now(timezone.utc)
        stages = build_stages(run, events, now)

        total = seconds(run.get("started_at"), run.get("finished_at"), now)
        intervals = []
        for s in stages:
            a = iso(s.started_at)
            b = iso(s.finished_at) if s.finished_at else (now if a else None)
            if a and b:
                intervals.append((a, b))
        busy = union_duration(intervals) if intervals else None
        overhead = None if total is None or busy is None else max(0.0, total - busy)

        repo = repo_root(args.repo)
        usage_path = args.usage_file or discover_usage(repo, args.run_id)
        pricing_path = args.pricing_file
        if not pricing_path:
            candidate = repo / "tools" / "config" / "model-pricing.json"
            pricing_path = candidate if candidate.exists() else None

        warnings = []
        usage_currency, usage_steps = "USD", {}
        if usage_path:
            u = load_json(usage_path)
            usage_currency = str(u.get("currency", "USD")).upper()
            usage_steps = u.get("steps", {})
        else:
            warnings.append("No usage sidecar found; CAO does not journal model token counts.")

        pricing_currency, models = usage_currency, {}
        if pricing_path:
            p = load_json(pricing_path)
            pricing_currency = str(p.get("currency", usage_currency)).upper()
            models = p.get("models", {})
        elif usage_steps:
            warnings.append("No pricing file found; only provider-reported costs can be included.")

        by_step = {}
        agg_tokens = defaultdict(int)
        known_cost = 0.0
        costed = 0
        for s in stages:
            raw = usage_steps.get(s.step_id) if isinstance(usage_steps, dict) else None
            cost, method, tokens, ws = compute_cost(
                raw if isinstance(raw, dict) else None,
                models if isinstance(models, dict) else {},
                usage_currency, pricing_currency)
            for k, v in tokens.items():
                agg_tokens[k] += v
            if cost is not None:
                known_cost += cost
                costed += 1
            warnings += [f"{s.step_id}: {w}" for w in ws]
            by_step[s.step_id] = {
                "model": raw.get("model") if isinstance(raw, dict) else None,
                "tokens": tokens,
                "cost": cost,
                "cost_method": method,
            }

        complete = bool(stages) and costed == len(stages)
        report = {
            "schema_version": "1.0",
            "run": {
                "run_id": run.get("run_id", args.run_id),
                "workflow_name": run.get("workflow_name"),
                "state": run.get("state"),
                "started_at": run.get("started_at"),
                "finished_at": run.get("finished_at"),
                "tier": run.get("tier"),
            },
            "timing": {
                "elapsed_seconds": total,
                "agent_busy_wall_seconds": busy,
                "unattributed_orchestration_seconds": overhead,
            },
            "stages": [
                {
                    "step_id": s.step_id,
                    "state": s.state,
                    "attempts": s.attempts,
                    "started_at": s.started_at,
                    "finished_at": s.finished_at,
                    "duration_seconds": s.duration,
                    "provider": s.provider,
                    "agent_profile": s.profile,
                } for s in stages
            ],
            "cost_by_step": by_step,
            "cost_summary": {
                "currency": pricing_currency,
                "known_cost": known_cost if costed else None,
                "total_cost": known_cost if complete else None,
                "costed_stages": costed,
                "total_stages": len(stages),
                "complete_cost_coverage": complete,
                "tokens": dict(sorted(agg_tokens.items())),
            },
            "event_gaps": gaps,
            "usage_file": str(usage_path) if usage_path else None,
            "pricing_file": str(pricing_path) if pricing_path else None,
            "warnings": warnings,
        }

        if args.json:
            rendered = json.dumps(report, indent=2)
        else:
            r = report["run"]
            lines = [
                f"Workflow: {r.get('workflow_name') or 'N/A'}",
                f"Run:      {r.get('run_id') or 'N/A'}",
                f"State:    {r.get('state') or 'N/A'}",
                "",
                f"Started:  {r.get('started_at') or 'N/A'}",
                f"Finished: {r.get('finished_at') or 'RUNNING'}",
                f"Elapsed:  {fmt_duration(total)}",
                f"Agent busy wall time: {fmt_duration(busy)}",
                f"Unattributed/orchestration: {fmt_duration(overhead)}",
                "",
            ]
            rows = []
            for s in report["stages"]:
                c = by_step[s["step_id"]]
                token_total = sum(c["tokens"].values()) if c["tokens"] else None
                cost_text = fmt_money(c["cost"], pricing_currency)
                if c["cost_method"]:
                    cost_text += f" ({c['cost_method']})"
                rows.append([
                    s["step_id"], s["state"], str(s["attempts"]),
                    fmt_duration(s["duration_seconds"]),
                    s["provider"] or "-", s["agent_profile"] or "-",
                    f"{token_total:,}" if token_total is not None else "N/A",
                    cost_text,
                ])
            lines.append(table(rows, ["Stage", "State", "Attempts", "Duration", "Provider", "Profile", "Tokens", "Cost"]))
            lines.append("")
            if complete:
                lines.append(f"Total cost: {fmt_money(known_cost, pricing_currency)}")
            elif costed:
                lines.append(f"Known cost: {fmt_money(known_cost, pricing_currency)} (partial: {costed}/{len(stages)} stages)")
                lines.append("Total cost: N/A — incomplete usage/pricing coverage")
            else:
                lines.append("Total cost: N/A — no usable token/cost data")
            if agg_tokens:
                lines.append("Tokens:    " + ", ".join(f"{k}={v:,}" for k, v in sorted(agg_tokens.items())))
            if gaps:
                lines.append("")
                lines.append(f"WARNING: CAO declared {len(gaps)} event gap(s); timing may be incomplete.")
            if warnings:
                lines.append("")
                lines.append("Warnings:")
                lines += [f"  - {w}" for w in warnings]
            rendered = "\n".join(lines)

        if args.output:
            args.output.write_text(rendered + "\n", encoding="utf-8")
        else:
            print(rendered)
        return 0
    except ReportError as e:
        print(f"run-report: ERROR: {e}", file=sys.stderr)
        return 2

if __name__ == "__main__":
    raise SystemExit(main())
